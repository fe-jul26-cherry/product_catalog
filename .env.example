VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_NOVA_POSHTA_API_KEY=

# AI assistant. The OpenRouter key is server-side only (never use a VITE_ prefix).
# Local dev: the Vite dev server serves /api/ai, so VITE_AI_API_URL=/api/ai.
# GitHub Pages build: the absolute URL of the deployed proxy,
# e.g. https://your-project.vercel.app/api/ai
VITE_AI_API_URL=
OPENROUTER_API_KEY=
# Comma-separated origins allowed to call the proxy from another domain,
# e.g. https://your-name.github.io
AI_ALLOWED_ORIGINS=
